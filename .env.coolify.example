# --- Proxy auth ---
# Username for basic auth
PROXY_USER=admin

# Bcrypt hash of your password.
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpassword'
PROXY_PASSWORD_HASH=$2a$14$...replace_with_generated_hash...

# Port to expose the proxy on (default: 3000)
PROXY_PORT=3000

# --- Neo4j ---
# Defaults match docker-compose.coolify.yaml; override if needed
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish123
