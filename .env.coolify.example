# --- Proxy auth ---
# Username for basic auth
PROXY_USER=admin

# Bcrypt hash of your password.
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpassword'
PROXY_PASSWORD_HASH=$2a$14$...replace_with_generated_hash...

# Port to expose the proxy on (default: 3000)
PROXY_PORT=3000

# --- Embedding (if LLM provider doesn't offer embeddings) ---
# EMBEDDING_API_KEY=your_zhipuai_key
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_MODEL=embedding-3

# --- Neo4j ---
# MUST NOT use NEO4J_* prefix — Neo4j container interprets those as config settings
GRAPH_USER=neo4j
GRAPH_PASSWORD=mirofish123
