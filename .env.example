# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# z.ai / OpenAI 兼容的 json_schema 服务端结构校验（默认启用）
# 仅少数服务端支持（如 z.ai GLM-4.6+）；不支持的服务端会自动回退到 json_object
# 如需完全关闭，取消下面这行的注释
# LLM_USE_JSON_SCHEMA=false

# ===== Embedding 配置（可选，不设则复用 LLM 配置）=====
# 如果你的 LLM 提供商不提供 embedding 接口，可单独配置
# EMBEDDING_API_KEY=your_embedding_api_key
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_MODEL=embedding-3

# ===== Neo4j / Graphiti 图谱配置 =====
# Self-hosted graph memory (replaces Zep Cloud)
# These defaults match docker-compose.coolify.yaml
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish123

# ===== 模拟性能调优 =====
# 每个平台的最大并发 LLM 请求数（并行模拟时两个平台各自独立计数）
# 默认 4；提高可加速模拟但会增加内存峰值，可能导致 OOM。
# OASIS_SEMAPHORE=4

# 每轮结束后等待秒数（给 API 速率限制窗口恢复时间）
# OASIS_ROUND_DELAY=2.0

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here